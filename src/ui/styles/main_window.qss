* {
    font-family: "Segoe UI";
    font-size: 13px;
}

QMainWindow, QWidget {
    background: #071a2c;
    color: #dcecff;
}

/* Text widgets inherit the panel colour behind them */
QLabel, QRadioButton, QCheckBox, #summaryItem {
    background: transparent;
}

#sidebar {
    background: #061729;
    border-right: 1px solid #173b5d;
}

#logo {
    color: #168cff;
    font-size: 42px;
    font-weight: bold;
}

#appTitle {
    color: #e7f3ff;
    font-size: 18px;
    font-weight: 600;
}

#sectionLabel {
    color: #6e9ac1;
    font-size: 11px;
    font-weight: 600;
    padding: 7px 8px;
}

#navButton {
    text-align: left;
    border: none;
    border-radius: 7px;
    color: #bdd7ee;
    background: transparent;
    padding: 12px 12px;
    font-size: 14px;
}

#navButton:hover {
    background: #0b2945;
}

#navButton[selected="true"] {
    background: #0758b8;
    color: white;
}

#version {
    color: #557b9e;
    font-size: 11px;
    padding: 8px;
}

#pageTitle {
    color: #eaf5ff;
    font-size: 27px;
    font-weight: 600;
}

#pageSubtitle {
    color: #86b8e3;
    font-size: 14px;
}

#tabFrame,
#filterPanel,
#summaryFrame,
#panel,
#detailsPanel {
    background: #0a2239;
    border: 1px solid #174464;
    border-radius: 7px;
}

#modeTab {
    min-width: 150px;
    min-height: 44px;
    border: none;
    border-right: 1px solid #174464;
    background: #0b2239;
    color: #a9c7e2;
    font-weight: 600;
}

#modeTab[active="true"] {
    background: #0759bd;
    color: white;
}

#fieldLabel {
    color: #dcecff;
    font-size: 12px;
    font-weight: 600;
}

QComboBox, QLineEdit {
    background: #071c30;
    border: 1px solid #1c4a70;
    border-radius: 6px;
    color: #dcecff;
    padding: 7px 10px;
    selection-background-color: #126cd2;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
    border-left: 1px solid #1c4a70;
}

QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #8cb7db;
}

QComboBox::down-arrow:on {
    border-top: none;
    border-bottom: 6px solid #8cb7db;
}

QComboBox:hover {
    border: 1px solid #2b6ea3;
}

QComboBox QAbstractItemView {
    background: #0b2239;
    color: #dcecff;
    border: 1px solid #1c4a70;
    selection-background-color: #0759bd;
}

QRadioButton {
    color: #bdd7ee;
    spacing: 7px;
}

QRadioButton::indicator {
    width: 17px;
    height: 17px;
}

#runButton {
    background: #0875f5;
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    padding: 8px 16px;
}

#runButton:hover {
    background: #1783ff;
}

#summaryFrame {
    min-height: 68px;
}

#summaryIcon_ok {
    color: #23d47b;
    font-size: 24px;
}

#summaryIcon_outdated {
    color: #ffad22;
    font-size: 24px;
}

#summaryIcon_missing {
    color: #ff4f56;
    font-size: 24px;
}

#summaryIcon_invalid {
    color: #7c9fc4;
    font-size: 24px;
}

#summaryNumber {
    color: #eaf5ff;
    font-size: 18px;
    font-weight: 600;
}

#summaryLabel {
    color: #7ea8ce;
    font-size: 10px;
}

#summaryLine {
    background: #1a405f;
    max-width: 1px;
}

#panelTitle {
    color: #e3f2ff;
    font-size: 16px;
    font-weight: 600;
}

#smallButton {
    background: #09243d;
    border: 1px solid #1c4a70;
    border-radius: 6px;
    color: #a9c7e2;
}

QTableWidget {
    background: #081e33;
    border: none;
    color: #cce4fa;
    outline: none;
}

QHeaderView::section {
    background: #0a2239;
    color: #72a1ca;
    border: none;
    border-bottom: 1px solid #174464;
    padding: 9px 7px;
    font-size: 10px;
    font-weight: 600;
}

/* Top-left corner where the row and column headers meet */
QTableCornerButton::section {
    background: #0a2239;
    border: none;
    border-bottom: 1px solid #174464;
}

QTableWidget::item {
    border-bottom: 1px solid #123650;
    padding: 8px;
}

QTableWidget::item:selected {
    background: #0d3e6c;
    color: white;
}

QTableWidget::indicator {
    width: 15px;
    height: 15px;
}

/* Panels that hold tables: darker so the table body blends in
   and the header stands out as a band */
#panel,
#detailsPanel {
    background: #091f35;
}

#detailIcon {
    color: #45a7ff;
    font-size: 25px;
}

#detailTitle {
    color: #e7f4ff;
    font-size: 17px;
    font-weight: 600;
}

#failedBadge {
    background: #4c1e2a;
    border: 1px solid #7d2d3b;
    border-radius: 10px;
    color: #ff6670;
    padding: 4px 9px;
    font-size: 11px;
    font-weight: 600;
}

#detailInfo {
    color: #89b1d3;
    line-height: 1.4;
    padding: 6px 0;
}

#detailLine {
    background: #174464;
    max-height: 1px;
}

#subTitle {
    color: #cfe8fc;
    font-size: 14px;
    font-weight: 600;
    padding-top: 5px;
}

#reportBox {
    background: #061728;
    border: 1px solid #173e5e;
    border-radius: 6px;
    color: #8ec4ec;
    font-family: "Consolas", "Courier New";
    font-size: 11px;
    padding: 8px;
}

QScrollBar:vertical {
    background: #071a2c;
    width: 9px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #214d70;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
}
